[Unit]
Description=DCR read-only observer and public dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dcrobserver
Group=dcrobserver
SupplementaryGroups=dcrstate dcrlogs dcrruntime dcrlaunch
WorkingDirectory=/opt/dcr/observer
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
TimeoutStopSec=15
Environment=NODE_ENV=production
# Token data directories are shared with the isolated fleet through dcrlogs.
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dcr/aristotle-output/input_aristotle/data /opt/dcr/observer/data
ReadOnlyPaths=/var/lib/dcr-launcher

[Install]
WantedBy=multi-user.target
