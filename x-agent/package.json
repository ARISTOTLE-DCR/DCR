{
  "name": "aristotle-x-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "scan": "tsx src/cli/scan.ts",
    "launch:preflight": "tsx src/cli/launch-preflight.ts",
    "launch:parse": "tsx src/cli/launch-parse.ts",
    "mock": "tsx src/cli/mock.ts",
    "x:me": "tsx src/cli/x-me.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.17.0",
    "twitter-api-v2": "^1.29.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
