BOT_HANDLE=your_bot_handle
BOT_USER_ID=123456789
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
# Choose OAuth 1.0 access credentials or OAuth2 credentials.
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_ACCESS_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
POLL_INTERVAL_MS=15000
MENTION_LOOKBACK_LIMIT=20
PROCESS_EXISTING_MENTIONS=false
STATE_FILE=.aristotle-state.json
LOG_LEVEL=info
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
SCAN_TIMEOUT_MS=12000
SCAN_CONFIRMATIONS=8
SCAN_CACHE_TTL_MS=120000
SCAN_MAX_CONCURRENT=2

# Public PONS launches. Keep false until the deployment has been verified.
LAUNCH_ENABLED=false
LAUNCH_FUNDER_PRIVATE_KEY=
LAUNCH_WALLET_PASSWORD=
LAUNCH_REGISTRY_FILE=/var/lib/dcr-launcher/registry.json
LAUNCH_KEYSTORE_DIR=/var/lib/dcr-launcher/keystores
# Hard cap: 0.001 ETH per generated launch wallet.
LAUNCH_FUNDING_WEI=1000000000000000
# Preserve at least 0.005 ETH on the main funding/signer wallet.
LAUNCH_FUNDER_MIN_REMAINING_WEI=5000000000000000
LAUNCH_CONFIRMATIONS=2
LAUNCH_GLOBAL_DAILY_LIMIT=25
PONS_FACTORY_ADDRESS=0xA5aAb3F0c6EeadF30Ef1D3Eb997108E976351feB
PONS_LAUNCH_CONFIG_ID=0
PONS_DEX_ID=0
PONS_IMAGE_UPLOAD_URL=https://pons-vercel-data-gateway.ozzy-6de.workers.dev/public/ipfs/image
LAUNCH_DASHBOARD_BASE_URL=https://dcr-rh.tech
TRANSACTION_LOCK_DIR=/var/lib/dcr-launcher/locks
